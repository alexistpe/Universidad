    fechaPago
    horaPago
    reserva: Reserva
    total
    
    crear()
    mostrar()
    conocerReserva()
    calcularTotal()
}

class Reserva{
    fecha
    hora
    fechaEvento
    Tipo
    salon: Salon
    totalPersonas
    turno
    datosCliente: Cliente
    subTotal

    crear()
    mostrar()
    conocerSalon()
    conocerCliente()
    AsignarTurno()
    CalcularSubtotal()
    CalcularDias()
}

class Tipo{
    nombre
    descripcion

    crear()
    mostrar()
}

class Cliente{
    nombre
    apellido
    dni
    email
    telefono
    genero
    edad

    crear()
    mostrar()
}

class Cancelacion{
    contratacion: Contratacion
    fecha
    hora
    montoDevolucion

    crear()
    mostrar()
    CalcularMontoCancelacion()
}

'Relaciones
Reserva -> Salon
Reserva -> Tipo
Reserva -> Cliente
Alquiler -> Reserva
Cancelacion -> Reserva

@enduml
/'



